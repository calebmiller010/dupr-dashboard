{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "src/ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "src/ui/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "src/ui/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/ui/dist/index.html"
    }
  ]
}
